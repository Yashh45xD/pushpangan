# ─── Server & DB ────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pushpangan_db?retryWrites=true&w=majority
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=pushpangan_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=pushpangan_refresh_token_super_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Nodemailer SMTP ─────────────────────────────────────────────────────────
# Use Gmail: enable "App Password" in Google Account security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Payment Gateways ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# ─── Admin Notification Contacts ──────────────────────────────────────────────
ADMIN_EMAIL=yashvarpe169@gmail.com
ADMIN_PHONE=8369407007

# ─── Twilio (WhatsApp Notifications) ───────────────────────────────────────────
# 1. Create free account at https://www.twilio.com
# 2. Go to Console → Messaging → Try WhatsApp Sandbox
# 3. Send join code from your phone to activate sandbox
# 4. Fill in credentials below
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox number (for development/testing):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Production: Use your approved Twilio WhatsApp Business number
